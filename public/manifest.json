{
  "manifest_version": 3,
  "name": "PDF из ЭБС: Лань, Юрайт, Айбукс",
  "$schema": "https://json.schemastore.org/chrome-manifest.json",
  "version": "0.0.2",
  "description": "Книги из ЭБС «Лань», «Юрайт» и «Айбукс» в PDF одним кликом. Для студентов и преподавателей.",
  "icons": {
    "16": "icons/icon_16.png",
    "32": "icons/icon_32.png",
    "48": "icons/icon_48.png",
    "128": "icons/icon_128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Chrome Ebs Loader",
    "default_popup": "popup.html"
  },
  "host_permissions": [
    "https://reader.lanbook.com/*",
    "https://urait.ru/*",
    "https://ibooks.ru/bookshelf/*"
  ],
  "permissions": [
    "tabs",
    "activeTab",
    "scripting",
    "storage",
    "downloads"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://reader.lanbook.com/*",
        "https://urait.ru/*",
        "https://ibooks.ru/bookshelf/*"
      ],
      "run_at": "document_idle",
      "js": [
        "contentScript.js"
      ]
    }
  ]
}